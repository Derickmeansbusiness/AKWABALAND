# Canonical address. Used for metadata, Open Graph and the redirects from
# www. and the Vercel preview host. Leave unset to use https://akwabaland.com.
NEXT_PUBLIC_SITE_URL=https://akwabaland.com

# PUBLIC | UNLISTED | PRIVATE | PASSWORD_PROTECTED
# Anything other than PUBLIC sets noindex/nofollow and X-Robots-Tag.
SITE_VISIBILITY=PRIVATE

# Required when SITE_VISIBILITY=PASSWORD_PROTECTED. Shared with invited viewers only.
SITE_ACCESS_CODE=

# Where /briefing requests are POSTed as JSON (Slack incoming webhook, Zapier, Make, internal endpoint).
# Unset → requests are logged on the server only.
BRIEFING_WEBHOOK_URL=

# local  → serve from public/media/akwaba (run `npm run media:fetch` first)
# remote → serve directly from the Higgsfield CDN (development only)
NEXT_PUBLIC_MEDIA_SOURCE=local
